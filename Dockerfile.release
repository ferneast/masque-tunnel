# Used by CI to package pre-built glibc binaries into a multi-arch image.
# For local builds, use the regular Dockerfile instead.
#
# The binary links glibc dynamically (BoringSSL is static), so the runtime
# base is debian-slim, not scratch.
FROM debian:bookworm-slim
ARG TARGETARCH
COPY build/linux/${TARGETARCH}/masque-tunnel /usr/local/bin/masque-tunnel
EXPOSE 443/udp
ENTRYPOINT ["/usr/local/bin/masque-tunnel"]
